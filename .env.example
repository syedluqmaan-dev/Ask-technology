# ─── Required ────────────────────────────────────────────────────────────────
# Supabase → Project settings → Database → Connection pooling (Transaction, port 6543)
DATABASE_URI=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5
# Long random string (openssl rand -hex 32). Signs CMS logins.
PAYLOAD_SECRET=
# Live address, no trailing slash
NEXT_PUBLIC_SERVER_URL=https://www.asktek.net

# ─── File storage (Supabase Storage, S3-compatible) ─────────────────────────
# Create a PRIVATE bucket named "asktek". Files are served through the CMS.
S3_BUCKET=asktek
S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM=ASK Technology <noreply@asktek.net>
# Where new leads, bookings and job applications are sent (comma separated)
LEAD_NOTIFY_TO=sales@asktek.net
CAREERS_NOTIFY_TO=hr@asktek.net

# ─── Cal.com ────────────────────────────────────────────────────────────────
# Cal.com → Settings → Developer → Webhooks → secret
CAL_WEBHOOK_SECRET=

# ─── Bot protection (Cloudflare Turnstile, optional but recommended) ────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Search engines ─────────────────────────────────────────────────────────
# Any 32-char hex string. Pings Bing/Yandex (IndexNow) when content is published.
INDEXNOW_KEY=
# Draft preview inside the CMS
PREVIEW_SECRET=

# ─── Migration from the old site (remove after launch) ──────────────────────
# Old images and files are loaded from here until imported into the CMS.
LEGACY_ORIGIN=https://asktek.net
